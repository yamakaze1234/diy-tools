  "cards": [
    {
      "dot": "cyan",
      "title": "后台异步，提交与拉取严格有序",
      "items": [
        "编辑先保存在本机；自动每 2 小时同步，也可点击立即同步。",
        "一轮：上传原图 → 提交修改 → 等待写入成功回执 → 拉取固定版本范围 → 合并本机。",
        "未确认提交则停止，保留原提交编号重试；拉取开始后别人新提交的数据下轮接收。"
      ]
    },
    {
      "dot": "violet",
      "title": "本机与云端各自留痕",
      "items": [
        "本机：每次保存同步业务字段记录 UUID、本机时间、登录成员及修改前后内容。",
        "云端：复用 mutationId、服务器时间、成员 ID 和版本；每条业务记录独立提交。",
        "本机修改记录与云端提交编号各自独立；本机保存不表示已上传，旧本机修改不补造。"
      ]
    },
    {
      "dot": "emerald",
      "title": "只读对比，不触发同步",
      "items": [
        "入口：多人同步 → 修改与提交记录；可看本机记录、云端记录和字段差异。",
        "对照上次同步基准、本机当前草稿与固定云端快照；标出双方变更及冲突字段。",
        "查看不上传、不覆盖本机、不推进同步游标；网络读取期间本机变化则重新比较。"
      ]
    },
    {
      "dot": "orange",
      "title": "共享边界与多人协作",
      "items": [
        "共享配置、人工核算价、店铺设置、模板、输出源、机箱图库及原图；ERP 成本、库存、PNG / ZIP 仅本机。",
        "不同顶层字段可合并；同字段冲突需选择，配件列表按整体比较。时间不决定覆盖顺序。",
        "两台电脑各自计时；甲先上传，乙再同步接收。其他成员姓名未返回时展示成员 ID。"
      ]
    }
